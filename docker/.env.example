# =====================================================
#  生产环境变量模板
#  复制此文件为 .env，填写真实值，不要提交到 git！
# =====================================================

# ── 数据库 ────────────────────────────────────────
POSTGRES_USER=saas_user
POSTGRES_PASSWORD=换成强密码_至少16位
POSTGRES_DB=ecommerce_saas

# ── Redis ─────────────────────────────────────────
REDIS_PASSWORD=换成强密码_至少16位

# ── JWT 密钥（随机字符串，越长越好）────────────────
# 生成方法：python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=在这里填入随机生成的64位十六进制字符串

# ── 域名配置 ──────────────────────────────────────
# 你的实际域名（用于 CORS 和前端 API 地址）
ALLOWED_ORIGINS=https://你的域名.com,https://www.你的域名.com
NEXT_PUBLIC_API_URL=https://你的域名.com/api/v1

# ── AI 服务 ───────────────────────────────────────
ANTHROPIC_API_KEY=你的MiniMax-API-Key
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
